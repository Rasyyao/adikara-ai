# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Real environment variables take precedence over this file.

# Endpoint "local" (default)
OLLAMA_URL=http://localhost:11434
# OLLAMA_API_KEY=

# Endpoint "remote": used with `evaluate.py ... --endpoints local remote`
# For endpoint NAME the variables are OLLAMA_<NAME>_URL and OLLAMA_<NAME>_API_KEY.
# A key is only sent over https (or to localhost).
OLLAMA_REMOTE_URL=https://ollama.example.com
OLLAMA_REMOTE_API_KEY=ganti-dengan-kunci-api-anda

# Postgres (pgvector) shared with the API; see adikara/.env
DATABASE_URL=postgresql://adikara:adikara@localhost:5433/adikara

# Cloudflare R2 (S3-compatible). Same bucket and keys as the API. materials.file_path holds the object key.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public r2.dev address of the bucket (reading only)
R2_PUBLIC_URL=

# Chat answers (worker). Leave CHAT_MODEL empty until a model is chosen: teachers then see a clear "not configured" reply.
# CHAT_ENDPOINT picks the Ollama endpoint ("local" or a name like "remote"), the same as for embeddings.
CHAT_MODEL=
CHAT_ENDPOINT=local
